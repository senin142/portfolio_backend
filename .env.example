# Server
PORT=3001
FRONTEND_ORIGIN=http://localhost:3000

# Database (must match docker-compose.yml for local dev)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=cms_user
DB_PASSWORD=cms_password
DB_NAME=content_cms
# DB_SSL=false

# To point at a hosted Supabase Postgres instead: use the project's "Session pooler"
# connection details (Project Settings -> Connect -> Direct connection -> Session pooler),
# NOT the direct connection host — that one is IPv6-only and unreachable from many networks.
# DB_HOST=aws-0-<region>.pooler.supabase.com
# DB_PORT=5432
# DB_USERNAME=postgres.<project-ref>
# DB_PASSWORD="<password>"   # quote it if it contains # or other shell/dotenv-special chars
# DB_NAME=postgres
# DB_SSL=true

# Auth
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=1d
