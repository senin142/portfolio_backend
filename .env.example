# Server
PORT=3001
FRONTEND_ORIGIN=http://localhost:3000

# Database (must match docker-compose.yml for local dev)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=cms_user
DB_PASSWORD=cms_password
DB_NAME=content_cms
# DB_SSL=false

# To point at a hosted Supabase Postgres instead: use the project's "Session pooler"
# connection details (Project Settings -> Connect -> Direct connection -> Session pooler),
# NOT the direct connection host — that one is IPv6-only and unreachable from many networks.
# DB_HOST=aws-0-<region>.pooler.supabase.com
# DB_PORT=5432
# DB_NAME=postgres
# DB_SSL=true
#
# IMPORTANT — Row Level Security: any table added directly via migration (rather than
# through Supabase's own table-creation UI) is NOT protected by RLS by default, which
# means Supabase's auto-generated public REST API will serve it to anyone holding the
# "publishable" key. Every migration that creates a table must also enable RLS on it —
# see 20260101000009-enable-rls.js.
#
# Day-to-day the app should connect as a scoped least-privilege role, not the postgres
# superuser — see 20260101000010-scoped-app-role.js, which creates one with RLS
# policies granting it exactly SELECT/INSERT/UPDATE/DELETE on this app's own tables.
# DB_USERNAME=cms_app.<project-ref>
# DB_PASSWORD="<cms_app-password>"   # quote it if it contains # or other shell/dotenv-special chars
#
# That migration needs superuser (CREATE ROLE requires it) — only set these two long
# enough to (re-)run it, then switch DB_USERNAME/DB_PASSWORD above back to cms_app:
# DB_SUPERUSER_USERNAME=postgres.<project-ref>
# DB_SUPERUSER_PASSWORD="<postgres-password>"
# DB_APP_ROLE_PASSWORD=<password to give the cms_app role>

# Auth
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=1d
